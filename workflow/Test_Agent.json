    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const message = ($json.chatInput || '').toLowerCase().trim();\n\nlet intent = 'unknown';\n\nconst hasTestPlan =\n  message.includes('test plan') ||\n  message.includes('testplan');\n\nconst hasTestCase =\n  message.includes('test case') ||\n  message.includes('testcase') ||\n  message.includes('test cases');\n\nconst hasBugTriage =\n  message.includes('bug triage') ||\n  message.includes('triage bug') ||\n  message.includes('triage bugs') ||\n  message.includes('bug triage');\n\nconst hasRCA =\n  message.includes('rca') ||\n  message.includes('root cause analysis') ||\n  message.includes('analysis');\n\nif(hasTestPlan && hasTestCase) {\n  intent = 'both';\n} else if (hasBugTriage) {\n  intent = 'bug_triage';\n} else if (hasTestCase) {\n  intent = 'test_case';\n} else if (hasTestPlan) {\n  intent = 'test_plan';\n} else if (hasRCA) {\n  intent = 'rca';\n}\n\nreturn {\n  json: {\n    ...$json,\n    intent\n  }\n};"
      },
